# Universal Server local/hosted environment template
# Copy this file to .env and fill in the real values.
# NEVER commit .env or real credentials.

# Dashboard authentication
DASHBOARD_PASSWORD=

# GitHub-backed encrypted database persistence
BACKUP_GITHUB_TOKEN=
BACKUP_GITHUB_REPO=SkelleTu/universal-server-backups
UNIVERSAL_SERVER_BACKUP_ENCRYPTION_KEY=

# Google Maps / Street View
GOOGLE_MAPS_API_KEY=

# Optional version/runtime settings
GAME_VERSION=0.1.0
SERVER_VERSION=1.0.0
SERVER_EXPIRATION_AT=
CORS_ORIGINS=
JSON_BODY_LIMIT=2mb
