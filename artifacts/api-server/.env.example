# Runtime
PORT=5000
NODE_ENV=production

# Clamour in the Darkness integration
GAME_VERSION=0.1.0
SERVER_VERSION=1.0.0
# Set this to the current Replit/Railway publication expiration in ISO 8601.
SERVER_EXPIRATION_AT=2026-09-19T00:00:00-03:00

# Browser clients. Comma-separated origins, or * for development.
CORS_ORIGINS=*
JSON_BODY_LIMIT=2mb

# Optional Railway persistent volume. Leave unset on Replit/local.
# RAILWAY_VOLUME_MOUNT_PATH=/data
